# Plantilla de variables de entorno. Copia este archivo a .env.local y llena los valores.
# NUNCA subas .env.local ni valores reales al repositorio (.gitignore ya los ignora).
# La app actual no necesita ningun secreto: todos los datos son sinteticos.
# Si algun dia se agrega un backend, los secretos del servidor NO llevan el prefijo NEXT_PUBLIC_.
# Todo lo que empieza con NEXT_PUBLIC_ termina en el JavaScript del navegador y es publico.
SYNC_SERVER_URL=
SYNC_SERVER_TOKEN=