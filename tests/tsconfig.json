{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "../.test-build",
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "unit/**/*.ts",
    "unit/**/*.tsx",
    "integration/**/*.ts",
    "integration/**/*.tsx",
    "../src/components/app-shell.tsx",
    "../src/lib/sync/queue.ts",
    "../src/lib/pwa/register-service-worker.ts"
  ]
}