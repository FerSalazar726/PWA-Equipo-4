{
  "name": "pwa-inspecciones-laboratorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
  "dev": "next dev",
  "build": "next build",
  "start": "next start",
  "preview:states": "tsc --project tests/tsconfig.json && node scripts/preview-states.mjs",
  "test": "node tests/starter.spec.mjs && npm run test:unit",
  "verify": "node scripts/verify.mjs",
  "test:unit": "tsc --project tests/tsconfig.json && node scripts/run-tests.mjs .test-build/tests/unit tests/unit",
  "test:integration": "tsc --project tests/tsconfig.json && node scripts/run-tests.mjs .test-build/tests/integration",
  "test:e2e": "node scripts/run-tests.mjs tests/e2e",
  "test:all": "npm test && npm run test:integration && npm run build && npm run test:e2e"
},
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.5"
  }
}